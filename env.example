# Copy this file to .env and fill in the keys you have.
# Every key is optional — data_fetcher.py skips a source gracefully if its
# key is missing, and logs a warning saying so.

OPENAI_API_KEY=
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockOracle/0.1

# Optional: DEBUG, INFO, WARNING, ERROR
STOCKORACLE_LOG_LEVEL=INFO
